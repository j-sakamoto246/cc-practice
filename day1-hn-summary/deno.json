{
  "tasks": {
    "hn-top10": "deno run --allow-net main.ts",
    "summary": "deno run --allow-net --allow-run summary.ts",
    "test": "deno test --allow-read tests/",
    "test:watch": "deno test --allow-read --watch tests/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "zod": "https://deno.land/x/zod@v3.23.8/mod.ts",
    "std/assert": "https://deno.land/std@0.224.0/assert/mod.ts",
    "std/testing/mock": "https://deno.land/std@0.224.0/testing/mock.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "include": ["no-unused-vars", "no-explicit-any"]
    }
  },
  "test": {
    "include": ["tests/"]
  }
}
