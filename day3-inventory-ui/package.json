{
  "name": "day3-inventory-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test a11y-audit a11y-keyboard",
    "test:lighthouse": "node scripts/lighthouse-a11y.mjs",
    "test:lighthouse:perf": "node scripts/lighthouse-perf.mjs",
    "analyze:bundle": "next build && node scripts/analyze-bundle.mjs",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook",
    "chromatic": "chromatic --exit-zero-on-changes",
    "loadtest:db:reset": "rm -f data/load-test.db* && DATABASE_URL=file:./data/load-test.db node scripts/seed-dummy.mjs",
    "loadtest:server": "DATABASE_URL=file:./data/load-test.db next dev --webpack --port 3200",
    "loadtest:server:prod": "DATABASE_URL=file:./data/load-test.db next start --port 3200",
    "loadtest:smoke": "mkdir -p load-tests/reports && SCENARIO_NAME=smoke k6 run load-tests/scenarios/smoke.js",
    "loadtest:products": "mkdir -p load-tests/reports && SCENARIO_NAME=products-list k6 run load-tests/scenarios/products-list.js",
    "loadtest:stock": "mkdir -p load-tests/reports && SCENARIO_NAME=stock-operations k6 run load-tests/scenarios/stock-operations.js",
    "loadtest:orders": "mkdir -p load-tests/reports && SCENARIO_NAME=order-creation k6 run load-tests/scenarios/order-creation.js",
    "loadtest": "mkdir -p load-tests/reports && SCENARIO_NAME=full-suite k6 run load-tests/scenarios/full-suite.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@libsql/client": "^0.17.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@chromatic-com/storybook": "^5.1.2",
    "@playwright/test": "^1.59.1",
    "@serwist/next": "^9.5.11",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-onboarding": "10.3.6",
    "@storybook/addon-vitest": "10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.11.4",
    "chromatic": "^16.10.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "10.3.6",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "serwist": "^9.5.11",
    "source-map-explorer": "^2.5.3",
    "storybook": "10.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  }
}
