# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# inventory db (local data only)
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

*storybook.log
storybook-static

# PWA (generated by Serwist on build)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
/public/workbox-*.js
/public/workbox-*.js.map

# Lighthouse temporary Chrome profile (created in error inside the repo)
/\\\\wsl.localhost\\Ubuntu\\tmp\\lh-chrome-profile/

# k6 load test reports (generated, do not commit)
/load-tests/reports/
