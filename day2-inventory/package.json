{
  "name": "day2-inventory",
  "version": "1.1.0",
  "description": "CLI-based inventory management system",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "inventory": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/cli.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'tests/**/*.ts'",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^0.19.10",
    "@libsql/client": "^0.17.2",
    "commander": "^14.0.0",
    "fast-check": "^4.7.0",
    "hono": "^4.12.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
